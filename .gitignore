# 根目录默认忽略所有，逐项放行需纳入版本管理的文件
/*

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/

# ===== 虚拟环境 =====
venv/
env/
ENV/

# ===== 数据库 =====
*.db
*.sqlite
*.sqlite3

# ===== 日志 =====
logs/
*.log

# ===== IDE =====
.vscode/
.idea/
*.swp
*.swo
*~

# 放行跨平台一键部署脚本
!setup.sh
# 放行测试套件与 pytest 配置（CI 通过 pytest 运行，必须纳入版本管理）
!tests/
!tests/**
# 测试缓存字节码仍需忽略
tests/__pycache__/
!conftest.py
!pytest.ini

# ===== OS =====
.DS_Store
Thumbs.db

# ===== 打包文件（仅上传到 GitHub Release，不入源码仓库）=====
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
SHA256SUMS.txt
*.SHA256SUMS.txt

# ==== 其他文件 ===
!/.github
!.gitignore
!/dist-packages